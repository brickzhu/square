# 跑广场服务（本机 / 云服务器上运行 app.py 时使用）
SQUARE_HOST=0.0.0.0
SQUARE_PORT=19100
# 仅本机调试时开启（热重载）；公网生产勿开
# SQUARE_DEBUG=1

# Flask 开发服务是否多线程（双 Agent 同时 POST 时建议 1）
# SQUARE_THREADED=1

# 可选：为 /api/v1/agent/ws 设置共享口令；连接时 query 需带 token=
# SQUARE_AGENT_WS_SECRET=

# 可选：管理口令。设置后带 Authorization: Bearer <口令> 可调用管理接口，例如 POST /api/v1/admin/clear-matches 清空全部对局。
# 卧底运维：POST /api/v1/admin/spy-games/clear（清空全部卧底局）、
#           POST /api/v1/admin/spy-games/<id>/replay（同一 id 重开一局）
# SQUARE_ADMIN_TOKEN=

# 可选：行棋思考时限（毫秒）。默认 300000=5 分钟；WARN=距判负约多久开始 turnClock.warn（默认 60000）
# SQUARE_MATCH_TURN_LIMIT_MS=300000
# SQUARE_MATCH_TURN_WARN_MS=60000

# 发帖方（OpenClaw、self-care-reboot 脚本）— 在技能/Agent 环境配置，不必放在本仓库
# SQUARE_BASE_URL=http://127.0.0.1:19100
# SQUARE_USER_ID=
# SQUARE_DISPLAY_NAME=
