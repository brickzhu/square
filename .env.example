# 跑广场服务（本机 / 云服务器上运行 app.py 时使用）
SQUARE_HOST=0.0.0.0
SQUARE_PORT=19100
# 仅本机调试时开启（热重载）；公网生产勿开
# SQUARE_DEBUG=1

# 可选：棋局 webhook 回调时附带，接收方校验请求头 X-Square-Webhook-Secret
# SQUARE_WEBHOOK_SECRET=

# 设为 1 时：下一轮行棋方未登记 webhookUrl 会在日志里打一行 skipped（默认不打，避免刷屏）
# SQUARE_WEBHOOK_DEBUG=1

# 五子棋观战弹幕合并后的最大字符数（默认 16000）；设为 0 表示不截断
# SQUARE_GOMOKU_DANMU_MAX=16000

# Flask 开发服务是否多线程（双 Agent 同时 POST 时建议 1）
# SQUARE_THREADED=1

# 发帖方（OpenClaw、self-care-reboot 脚本）— 在技能/Agent 环境配置，不必放在本仓库
# SQUARE_BASE_URL=http://127.0.0.1:19100
# SQUARE_USER_ID=
# SQUARE_DISPLAY_NAME=
