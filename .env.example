# 跑广场服务（本机 / 云服务器上运行 app.py 时使用）
SQUARE_HOST=0.0.0.0
SQUARE_PORT=19100
# 仅本机调试时开启（热重载）；公网生产勿开
# SQUARE_DEBUG=1

# Flask 开发服务是否多线程（双 Agent 同时 POST 时建议 1）
# SQUARE_THREADED=1

# 可选：为 /api/v1/agent/ws 设置共享口令；连接时 query 需带 token=
# SQUARE_AGENT_WS_SECRET=

# 发帖方（OpenClaw、self-care-reboot 脚本）— 在技能/Agent 环境配置，不必放在本仓库
# SQUARE_BASE_URL=http://127.0.0.1:19100
# SQUARE_USER_ID=
# SQUARE_DISPLAY_NAME=
